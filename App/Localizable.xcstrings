          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Forewarn mede o próprio consumo de energia e mostra-o no menu. O objetivo: menos de 0,05% da bateria por dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn își măsoară propriul consum de energie și îl afișează în meniu. Obiectivul: sub 0,05% din baterie pe zi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn meria vlastnú spotrebu energie a zobrazuje ju v ponuke. Cieľ: menej ako 0,05% batérie denne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn meri lastno porabo energije in jo prikaže v meniju. Cilj: manj kot 0,05% baterije na dan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn mäter sin egen energiförbrukning och visar den i menyn. Målet: under 0,05 % av batteriet per dag."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn вимірює власне енергоспоживання і показує його в меню. Мета: менше 0,05% заряду на день."
          }
        }
      }
    },
    "Forewarn needs no account and asks for no special permissions." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn не изисква акаунт и не иска специални разрешения."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn no necessita cap compte ni demana permisos especials."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn nepotřebuje účet ani zvláštní oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn kræver ingen konto og beder ikke om særlige tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn braucht kein Account und keine besonderen Berechtigungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Forewarn δεν χρειάζεται λογαριασμό ούτε ζητά ειδικές άδειες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn no necesita cuenta ni pide permisos especiales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ei vaja kontot ega küsi erilisi õigusi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ei tarvitse tiliä eikä pyydä erityisiä lupia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ne demande aucun compte ni autorisation particulière."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl cuntas ag teastáil ó Forewarn agus ní iarrann sé aon cheadanna speisialta."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ne treba račun ni posebna dopuštenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forewarn nem igényel fiókot és különleges engedélyeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn non richiede account né permessi speciali."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
