    "macOS stops charging here because of the %lld%% limit set in System Settings › Battery. Forecasts start from this level when you unplug." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS спира зареждането тук заради лимита от %lld%%, зададен в Системни настройки › Батерия. Прогнозите започват от това ниво, когато изключите зарядното."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS deixa de carregar aquí pel límit del %lld %% definit a Configuració del Sistema › Bateria. Les previsions parteixen d’aquest nivell en desconnectar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zde přestane nabíjet kvůli limitu %lld%% nastavenému v Nastavení systému › Baterie. Po odpojení začnou předpovědi od této úrovně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS stopper opladningen her på grund af grænsen på %lld %% i Systemindstillinger › Batteri. Prognoserne starter fra dette niveau, når du tager stikket ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS stoppt das Laden hier wegen des Limits von %lld %% in Systemeinstellungen › Batterie. Prognosen starten bei diesem Stand, sobald du das Netzteil trennst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS σταματά τη φόρτιση εδώ λόγω του ορίου %lld%% που ορίστηκε στις Ρυθμίσεις συστήματος › Μπαταρία. Οι προβλέψεις ξεκινούν από αυτή τη στάθμη όταν αποσυνδέσετε τον φορτιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS deja de cargar aquí por el límite del %lld %% fijado en Ajustes del Sistema › Batería. Las previsiones parten de este nivel al desconectar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lõpetab siin laadimise, sest jaotises Süsteemiseaded › Aku on määratud %lld%% limiit. Prognoosid algavad sellelt tasemelt, kui laadija lahti ühendad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lopettaa latauksen tähän, koska kohdassa Järjestelmäasetukset › Akku on asetettu %lld %%:n raja. Ennusteet alkavat tästä tasosta, kun irrotat laturin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS arrête la charge ici en raison de la limite de %lld %% définie dans Réglages Système › Batterie. Les prévisions partent de ce niveau quand vous débranchez."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopann macOS ag luchtú anseo mar gheall ar an teorainn %lld%% atá socraithe in System Settings › Battery. Tosaíonn na réamhaisnéisí ón leibhéal seo nuair a dhíphlugálann tú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ovdje prestaje puniti zbog ograničenja od %lld%% postavljenog u Postavkama sustava › Baterija. Kad isključite punjač, prognoze kreću od ove razine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS itt leállítja a töltést a Rendszerbeállítások › Akkumulátor alatt beállított %lld%%-os korlát miatt. Leválasztás után az előrejelzés ettől a szinttől indul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS smette di caricare qui per il limite di %lld%% impostato in Impostazioni di Sistema › Batteria. Le previsioni partono da questo livello quando scolleghi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS čia nustoja įkrauti dėl %lld%% limito, nustatyto Sistemos nustatymuose › Akumuliatorius. Atjungus maitinimą, prognozės prasidės nuo šio lygio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS šeit pārtrauc uzlādi %lld%% limita dēļ, kas iestatīts sadaļā Sistēmas iestatījumi › Akumulators. Prognozes sāksies no šī līmeņa, kad atvienosiet lādētāju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS jieqaf jiċċarġja hawn minħabba l-limitu ta’ %lld%% issettjat f’System Settings › Battery. It-tbassir jibda minn dan il-livell meta tiddiskonnettja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS slutter å lade her på grunn av grensen på %lld %% i Systeminnstillinger › Batteri. Prognosene starter fra dette nivået når du kobler fra laderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS stopt hier met laden vanwege de limiet van %lld%% in Systeeminstellingen › Batterij. Voorspellingen starten vanaf dit niveau als je loskoppelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS przestaje tu ładować z powodu limitu %lld%% ustawionego w Ustawieniach systemowych › Bateria. Po odłączeniu prognozy zaczną się od tego poziomu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS para de carregar aqui devido ao limite de %lld%% definido em Definições do Sistema › Bateria. As previsões partem deste nível quando desligar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS oprește încărcarea aici din cauza limitei de %lld%% setate în Configurări sistem › Baterie. Previziunile pornesc de la acest nivel când deconectați."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tu prestane nabíjať pre limit %lld%% nastavený v Systémových nastaveniach › Batéria. Po odpojení začnú predpovede od tejto úrovne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tu preneha polniti zaradi omejitve %lld%%, nastavljene v Sistemskih nastavitvah › Baterija. Ko odklopite polnilnik, se napovedi začnejo pri tej ravni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS slutar ladda här på grund av gränsen på %lld %% i Systeminställningar › Batteri. Prognoserna utgår från den här nivån när du kopplar ur laddaren."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS припиняє заряджання тут через ліміт %lld%%, встановлений у Системних параметрах › Акумулятор. Прогнози почнуться з цього рівня, коли ви від’єднаєте живлення."
          }
        }
      }
    },
