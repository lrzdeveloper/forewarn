        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dearann Apple an ceallra seo chun 80%% dá chumas bunaidh a choinneáil tar éis %@ timthriall."
          }
        },
        "hr" : {
          "stringUnit" : {
