          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn nav vajadzīgs konts, un tas neprasa īpašas atļaujas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ma jeħtieġ l-ebda kont u ma jitlob l-ebda permess speċjali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
