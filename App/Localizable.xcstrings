    "iPhone hotspots and connections macOS marks as metered. Wi-Fi and Ethernet are not counted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотспотове от iPhone и връзки, които macOS отбелязва като платени по трафик. Wi-Fi и Ethernet не се броят."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punts d’accés d’iPhone i connexions que macOS marca com a dades limitades. No es compten la Wi-Fi ni l’Ethernet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspoty iPhonu a připojení, která macOS označí jako měřená. Wi-Fi a Ethernet se nepočítají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internetdeling fra iPhone og forbindelser, som macOS markerer som databegrænsede. Wi-Fi og Ethernet tælles ikke med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-Hotspots und Verbindungen, die macOS als getaktet markiert. WLAN und Ethernet zählen nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspot του iPhone και συνδέσεις που το macOS επισημαίνει ως συνδέσεις με ογκοχρέωση. Τα Wi-Fi και Ethernet δεν μετρώνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos de acceso de iPhone y conexiones que macOS marca como de uso medido. No se cuentan la Wi-Fi ni Ethernet."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'i levialad ja ühendused, mille macOS märgib mahupiiranguga ühendusteks. Wi-Fi-d ja Etherneti ei arvestata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen yhteyspisteet ja yhteydet, jotka macOS merkitsee datarajoitetuiksi. Wi-Fiä ja Ethernetiä ei lasketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partages de connexion d’iPhone et connexions que macOS considère comme limitées. Le Wi-Fi et l’Ethernet ne sont pas comptés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspots iPhone agus naisc a mharcálann macOS mar mhéadraithe. Ní chomhairítear Wi-Fi ná Ethernet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristupne točke iPhonea i veze koje macOS označava kao mjerene. Wi-Fi i Ethernet se ne broje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-os hotspotok és a macOS által forgalomdíjasnak jelölt kapcsolatok. A Wi-Fi és az Ethernet nem számít bele."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspot dell'iPhone e connessioni che macOS segna a consumo. Wi-Fi ed Ethernet non vengono contati."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone prieigos taškai ir ryšiai, kuriuos macOS žymi kaip matuojamus. Wi-Fi ir Ethernet neskaičiuojami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone tīklāji un savienojumi, ko macOS atzīmē kā ierobežotus. Wi-Fi un Ethernet netiek skaitīti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspots tal-iPhone u konnessjonijiet li macOS jimmarka b’data limitata. Il-Wi-Fi u l-Ethernet ma jingħaddux."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delt Internett fra iPhone og tilkoblinger som macOS merker som databegrensede. Wi-Fi og Ethernet telles ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-hotspots en verbindingen die macOS als verbinding met datalimiet aanmerkt. Wifi en ethernet tellen niet mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspoty iPhone’a i połączenia oznaczone przez macOS jako taryfowe. Wi-Fi i Ethernet nie są liczone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspots de iPhone e ligações que o macOS marca como limitadas. Wi-Fi e Ethernet não são contados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspoturile iPhone și conexiunile marcate de macOS drept contorizate. Wi-Fi și Ethernet nu sunt numărate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotspoty iPhonu a pripojenia, ktoré macOS označí ako merané. Wi-Fi a Ethernet sa nepočítajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostopne točke iPhona in povezave, ki jih macOS označi kot merjene. Wi-Fi in Ethernet se ne štejeta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internetdelning från iPhone och anslutningar som macOS markerar som databegränsade. Wi-Fi och Ethernet räknas inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим модема iPhone та з’єднання, які macOS позначає як лімітні. Wi-Fi та Ethernet не враховуються."
          }
        }
      }
    },
    "Keeps an eye on a monthly hotspot or data plan limit. You can turn it on in a moment." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следи месечния лимит на хотспот или план за данни. Можете да го включите след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila el límit mensual d’un punt d’accés o d’un pla de dades. Pots activar-ho d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlídá měsíční limit hotspotu nebo datového tarifu. Zapnout ho můžete za chvíli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder øje med en månedlig grænse for internetdeling eller dataabonnement. Du kan slå det til om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält das Monatslimit eines Hotspots oder Datentarifs im Blick. Du kannst es gleich aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθεί το μηνιαίο όριο ενός hotspot ή προγράμματος δεδομένων. Μπορείτε να το ενεργοποιήσετε σε λίγο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila el límite mensual de un punto de acceso o plan de datos. Puedes activarlo en un momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jälgib leviala või andmesidepaketi kuu limiiti. Saad selle kohe sisse lülitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa yhteyspisteen tai liittymän kuukausirajaa. Voit ottaa sen käyttöön hetken päästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveille la limite mensuelle d’un partage de connexion ou d’un forfait. Vous pourrez l’activer dans un instant."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinníonn sé súil ar theorainn mhíosúil hotspot nó plean sonraí. Is féidir é a chasadh air i gceann nóiméid."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prati mjesečno ograničenje pristupne točke ili podatkovnog paketa. Možete ga uključiti za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyeli a havi hotspot- vagy adatkeretet. Mindjárt bekapcsolhatja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene d'occhio il limite mensile dell'hotspot o del piano dati. Puoi attivarlo tra un attimo."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stebi mėnesio prieigos taško arba duomenų plano limitą. Įjungti galėsite netrukus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzrauga tīklāja vai datu plāna mēneša limitu. To varēsiet ieslēgt pēc brīža."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iżomm għajnejh fuq il-limitu ta’ kull xahar ta’ hotspot jew pjan tad-data. Tista’ tixgħelu fi ftit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder øye med en månedlig grense for Delt Internett eller dataabonnement. Du kan slå det på om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de maandlimiet van een hotspot of databundel in de gaten. Je kunt dit zo meteen aanzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilnuje miesięcznego limitu hotspotu lub pakietu danych. Możesz to włączyć za chwilę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigia o limite mensal de um hotspot ou tarifário de dados. Pode ativá-lo daqui a pouco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește limita lunară a unui hotspot sau abonament de date. O puteți activa imediat."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stráži mesačný limit hotspotu alebo dátového balíka. Zapnúť ho môžete o chvíľu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremlja mesečno omejitev dostopne točke ali podatkovnega paketa. Vklopite ga lahko čez trenutek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller koll på en månadsgräns för internetdelning eller mobilabonnemang. Du kan slå på det strax."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежить за місячним лімітом режиму модема чи тарифу. Увімкнути можна за мить."
          }
        }
      }
    },
