        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan es preveu que el disc s’ompli en menys de tres setmanes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se má disk zaplnit do tří týdnů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når disken forventes at blive fuld inden for tre uger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Festplatte voraussichtlich innerhalb von drei Wochen voll ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ο δίσκος αναμένεται να γεμίσει μέσα σε τρεις εβδομάδες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se prevé que el disco se llene en menos de tres semanas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui ketas eeldatavasti saab kolme nädala jooksul täis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun levyn odotetaan täyttyvän kolmen viikon sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le disque devrait être plein d’ici trois semaines."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuair a mheastar go líonfar an diosca laistigh de thrí seachtaine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad se očekuje da će se disk napuniti unutar tri tjedna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a lemez várhatóan három héten belül megtelik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si prevede che il disco si riempia entro tre settimane."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai numatoma, kad diskas prisipildys per tris savaites."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad paredzams, ka disks piepildīsies trīs nedēļu laikā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta d-diska mistennija timtela fi żmien tliet ġimgħat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når disken ventes å bli full innen tre uker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de schijf naar verwachting binnen drie weken vol is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy dysk ma się zapełnić w ciągu trzech tygodni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando se prevê que o disco encha nas próximas três semanas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când discul se va umple probabil în trei săptămâni."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď sa má disk zaplniť do troch týždňov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko naj bi se disk napolnil v treh tednih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När disken väntas bli full inom tre veckor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли диск, імовірно, заповниться протягом трьох тижнів."
          }
        }
      }
    },
    "When you are on pace to use up your monthly limit." : {
