    "You usually plug in at %@, and at this pace the battery stays above 10%% until then." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обикновено зареждате в %@ и при това темпо батерията остава над 10%% дотогава."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment el connectes a les %@, i a aquest ritme la bateria es manté per sobre del 10 %% fins aleshores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvykle nabíjíte v %@ a tímto tempem zůstane baterie do té doby nad 10%%."
