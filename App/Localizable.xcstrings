        }
      }
    },
    "Forewarn couldn't restart. Try again, or quit Forewarn and open it again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn не успя да се рестартира. Опитайте отново или излезте от Forewarn и го отворете пак."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut reiniciar el Forewarn. Torna-ho a provar, o surt del Forewarn i torna’l a obrir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se nepodařilo restartovat. Zkuste to znovu, nebo Forewarn ukončete a znovu otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn kunne ikke genstarte. Prøv igen, eller afslut Forewarn, og åbn den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn konnte nicht neu starten. Versuche es erneut oder beende Forewarn und öffne es wieder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επανεκκίνηση του Forewarn. Δοκιμάστε ξανά ή κλείστε το Forewarn και ανοίξτε το πάλι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn no se ha podido reiniciar. Vuelve a intentarlo, o sal de Forewarn y ábrelo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarni ei saanud taaskäivitada. Proovi uuesti või sulge Forewarn ja ava see uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarnia ei voitu käynnistää uudelleen. Yritä uudelleen tai lopeta Forewarn ja avaa se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn n’a pas pu redémarrer. Réessayez, ou quittez Forewarn et rouvrez-le."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níorbh fhéidir Forewarn a atosú. Bain triail eile as, nó scoir de Forewarn agus oscail arís é."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se nije mogao ponovno pokrenuti. Pokušajte ponovno ili zatvorite Forewarn i ponovno ga otvorite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forewarn nem tudott újraindulni. Próbálja újra, vagy lépjen ki a Forewarnból, és nyissa meg újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile riavviare Forewarn. Riprova, oppure esci da Forewarn e riaprilo."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko paleisti Forewarn iš naujo. Bandykite dar kartą arba išeikite iš Forewarn ir vėl jį atidarykite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn neizdevās restartēt. Mēģiniet vēlreiz vai aizveriet Forewarn un atveriet to no jauna."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ma setax jerġa’ jibda. Erġa’ pprova, jew oħroġ minn Forewarn u erġa’ iftħu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn kunne ikke starte på nytt. Prøv igjen, eller avslutt Forewarn og åpne den igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn kon niet opnieuw starten. Probeer het nog eens, of stop Forewarn en open het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się ponownie uruchomić Forewarn. Spróbuj jeszcze raz albo zamknij Forewarn i otwórz go ponownie."
