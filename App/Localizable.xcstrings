    "On power, but not charging right now. macOS sometimes pauses at a high level to protect the battery." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включен в захранването, но не се зарежда в момента. macOS понякога спира на високо ниво, за да пази батерията."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectat al corrent, però no carrega ara mateix. De vegades macOS s’atura en un nivell alt per protegir la bateria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojeno k napájení, ale teď se nenabíjí. macOS někdy nabíjení na vysoké úrovni pozastaví, aby chránil baterii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsluttet strøm, men oplader ikke lige nu. macOS holder nogle gange pause ved et højt niveau for at beskytte batteriet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Strom, lädt aber gerade nicht. macOS pausiert manchmal bei hohem Ladestand, um die Batterie zu schonen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεδεμένο στο ρεύμα, αλλά δεν φορτίζει αυτή τη στιγμή. Το macOS μερικές φορές σταματά σε υψηλή στάθμη για να προστατεύσει την μπαταρία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectado, pero sin cargar ahora mismo. macOS a veces se detiene en un nivel alto para proteger la batería."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vooluvõrgus, kuid praegu ei laadi. macOS peatab vahel laadimise kõrgel tasemel, et akut kaitsta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtalähde kytketty, mutta lataus ei ole käynnissä. macOS keskeyttää latauksen joskus korkealla tasolla akun suojaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur secteur, mais pas en charge pour l’instant. macOS s’arrête parfois à un niveau élevé pour protéger la batterie."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceangailte le cumhacht, ach gan a bheith á luchtú faoi láthair. Uaireanta stopann macOS ag leibhéal ard chun an ceallra a chosaint."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priključeno na napajanje, ali se trenutačno ne puni. macOS ponekad zaustavi punjenje na visokoj razini kako bi zaštitio bateriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hálózati áramon van, de most nem tölt. A macOS néha magas szinten szünetelteti a töltést az akkumulátor védelmében."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegato, ma non in carica al momento. A volte macOS si ferma a un livello alto per proteggere la batteria."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijungta prie maitinimo, bet šiuo metu neįkraunama. macOS kartais sustoja ties aukštu lygiu, kad apsaugotų akumuliatorių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievienots strāvai, bet pašlaik netiek uzlādēts. macOS dažreiz apstājas augstā līmenī, lai saudzētu akumulatoru."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imqabbad, imma mhux qed jiċċarġja bħalissa. Xi drabi macOS jieqaf f’livell għoli biex jipproteġi l-batterija."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koblet til strøm, men lader ikke akkurat nå. macOS tar noen ganger pause på et høyt nivå for å beskytte batteriet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangesloten, maar laadt nu niet. macOS pauzeert soms op een hoog niveau om de batterij te sparen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasilacz podłączony, ale ładowanie jest wstrzymane. macOS czasem zatrzymuje się na wysokim poziomie, aby chronić baterię."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado à corrente, mas sem carregar de momento. Por vezes, o macOS para num nível alto para proteger a bateria."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectat la priză, dar nu se încarcă acum. Uneori macOS face pauză la un nivel ridicat pentru a proteja bateria."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojené k napájaniu, ale teraz sa nenabíja. macOS niekedy pozastaví nabíjanie na vysokej úrovni, aby chránil batériu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priključeno na napajanje, a se trenutno ne polni. macOS včasih ustavi polnjenje pri visoki ravni, da zaščiti baterijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansluten till ström men laddar inte just nu. macOS pausar ibland vid en hög nivå för att skydda batteriet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключено до живлення, але зараз не заряджається. macOS іноді зупиняється на високому рівні, щоб берегти акумулятор."
          }
        }
      }
    },
    "Once a week, on power, Forewarn adds up folder sizes: Xcode build files, caches, and Downloads if allowed. It never opens your files." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веднъж седмично, на захранване, Forewarn сумира размерите на папки: файлове от компилации на Xcode, кешове и Изтегляния, ако е разрешено. Никога не отваря файловете ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cop per setmana, connectat al corrent, Forewarn suma la mida de les carpetes: fitxers de compilació de Xcode, memòries cau i Baixades si ho permets. Mai obre els teus fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednou týdně, při napájení ze sítě, Forewarn sečte velikosti složek: soubory sestavení Xcode, mezipaměti a Stahované soubory, pokud to povolíte. Nikdy neotevírá vaše soubory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gang om ugen, når Mac'en er tilsluttet strøm, lægger Forewarn mappestørrelser sammen: Xcode-buildfiler, caches og Overførsler, hvis det er tilladt. Den åbner aldrig dine filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal pro Woche, am Strom, summiert Forewarn Ordnergrößen: Xcode-Build-Dateien, Caches und, falls erlaubt, „Downloads“. Es öffnet nie deine Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία φορά την εβδομάδα, όταν είναι στο ρεύμα, το Forewarn αθροίζει τα μεγέθη φακέλων: αρχεία build του Xcode, cache και Λήψεις, αν επιτρέπεται. Δεν ανοίγει ποτέ τα αρχεία σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez por semana, con corriente, Forewarn suma el tamaño de las carpetas: archivos de compilación de Xcode, cachés y Descargas si lo permites. Nunca abre tus archivos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kord nädalas, kui Mac on vooluvõrgus, liidab Forewarn kokku kaustade suurused: Xcode'i ehitusfailid, vahemälud ja lubamisel Allalaadimised. See ei ava kunagi su faile."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerran viikossa, kun Mac on kytketty virtalähteeseen, Forewarn laskee kansioiden koot yhteen: Xcoden käännöstiedostot, välimuistit ja Lataukset, jos sallittu. Se ei koskaan avaa tiedostojasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois par semaine, sur secteur, Forewarn additionne la taille des dossiers : fichiers de build Xcode, caches, et Téléchargements si autorisé. Il n’ouvre jamais vos fichiers."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uair sa tseachtain, agus é ceangailte le cumhacht, suimíonn Forewarn méideanna fillteán: comhaid tógála Xcode, taiscí, agus Downloads má cheadaítear. Ní osclaíonn sé do chomhaid riamh."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednom tjedno, kad je Mac na napajanju, Forewarn zbraja veličine mapa: datoteke izgradnje za Xcode, predmemorije i Preuzimanja ako dopustite. Nikad ne otvara vaše datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetente egyszer, hálózati áramon a Forewarn összeadja a mappaméreteket: Xcode build-fájlok, gyorsítótárak és – ha engedélyezi – a Letöltések. Fájlokat sosem nyit meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta a settimana, da collegato, Forewarn somma le dimensioni delle cartelle: file di build di Xcode, cache e Download se consentito. Non apre mai i tuoi file."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartą per savaitę, kai prijungtas maitinimas, Forewarn susumuoja aplankų dydžius: Xcode kompiliavimo failų, podėlių ir, jei leidžiama, Atsisiuntimų. Jūsų failai niekada neatidaromi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizi nedēļā, kad pievienots strāvai, Forewarn saskaita mapju izmērus: Xcode būvējumu failus, kešatmiņas un, ja atļauts, Lejupielādes. Tas nekad neatver jūsu failus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darba fil-ġimgħa, meta jkun imqabbad, Forewarn jgħodd id-daqs tal-folders: fajls tal-build ta’ Xcode, cache, u Downloads jekk tippermetti. Qatt ma jiftaħ il-fajls tiegħek."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én gang i uken, når Macen er koblet til strøm, summerer Forewarn mappestørrelser: Xcode-byggfiler, buffere og Nedlastinger hvis tillatt. Den åpner aldri filene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eens per week, op netstroom, telt Forewarn mapgroottes op: Xcode-buildbestanden, caches en Downloads als dat mag. Het opent nooit je bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz w tygodniu, przy zasilaniu, Forewarn sumuje rozmiary folderów: pliki kompilacji Xcode, pamięci podręczne oraz Pobrane rzeczy, jeśli pozwolisz. Nigdy nie otwiera twoich plików."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vez por semana, ligado à corrente, o Forewarn soma o tamanho das pastas: ficheiros de compilação do Xcode, caches e Transferências, se permitido. Nunca abre os seus ficheiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dată pe săptămână, la priză, Forewarn adună dimensiunile dosarelor: fișierele de build Xcode, cache-urile și Descărcări, dacă permiteți. Nu vă deschide niciodată fișierele."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz týždenne, pri napájaní zo siete, Forewarn spočíta veľkosti priečinkov: súbory zostavenia Xcode, vyrovnávacie pamäte a Stiahnuté, ak to povolíte. Nikdy neotvára vaše súbory."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkrat na teden, ko je Mac priključen na napajanje, Forewarn sešteje velikosti map: datoteke gradnje Xcode, predpomnilnike in Prenose, če to dovolite. Nikoli ne odpre vaših datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gång i veckan, när Macen är ansluten till ström, summerar Forewarn mappstorlekar: Xcode-byggfiler, cachar och Hämtade filer om det tillåts. Den öppnar aldrig dina filer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз на тиждень, під час живлення від мережі, Forewarn підсумовує розміри папок: файли збирання Xcode, кеші та «Завантаження», якщо дозволено. Він ніколи не відкриває ваші файли."
          }
        }
      }
    },
    "Only the totals are stored, next to the rest of Forewarn's data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
