    "Heat wears a battery fastest. Keep the Mac out of the sun and off soft surfaces when it works hard." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топлината износва батерията най-бързо. Пазете Mac далеч от слънце и меки повърхности, когато работи усилено."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calor és el que més desgasta la bateria. Mantén el Mac lluny del sol i de superfícies toves quan treballi a fons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterii nejvíc opotřebovává teplo. Když Mac hodně pracuje, nenechávejte ho na slunci ani na měkkém povrchu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varme slider mest på et batteri. Hold Mac'en ude af solen og væk fra bløde underlag, når den arbejder hårdt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitze verschleißt eine Batterie am schnellsten. Halte den Mac von der Sonne und weichen Unterlagen fern, wenn er stark arbeitet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ζέστη φθείρει την μπαταρία πιο γρήγορα από οτιδήποτε. Κρατήστε το Mac μακριά από τον ήλιο και από μαλακές επιφάνειες όταν δουλεύει έντονα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calor es lo que más desgasta la batería. Mantén el Mac lejos del sol y de superficies blandas cuando trabaje a fondo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuumus kulutab akut kõige kiiremini. Hoia Mac päikese eest ja pehmetelt pindadelt eemal, kui see teeb rasket tööd."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuumuus kuluttaa akkua eniten. Pidä Mac poissa auringosta ja pehmeiltä alustoilta, kun se tekee raskasta työtä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaleur use la batterie plus que tout. Gardez le Mac à l’abri du soleil et loin des surfaces molles quand il travaille dur."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is é an teas is tapúla a chaitheann ceallra. Coinnigh an Mac as an ngrian agus amach ó dhromchlaí boga nuair a bhíonn sé ag obair go dian."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplina najbrže troši bateriju. Držite Mac podalje od sunca i mekanih površina kad radi punom snagom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az akkumulátort a hő koptatja a leggyorsabban. Nagy terhelésnél tartsa a Macet napfénytől távol, és ne tegye puha felületre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il calore è ciò che usura di più la batteria. Tieni il Mac lontano dal sole e da superfici morbide quando lavora molto."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akumuliatorių greičiausiai dėvi karštis. Kai Mac sunkiai dirba, laikykite jį atokiau nuo saulės ir ne ant minkštų paviršių."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akumulatoru visātrāk nolieto karstums. Kad Mac strādā ar lielu slodzi, turiet to prom no saules un ne uz mīkstām virsmām."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-sħana tikkonsma l-batterija l-aktar malajr. Żomm il-Mac ’il bogħod mix-xemx u minn fuq uċuħ rotob meta jkun qed jaħdem ħafna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varme sliter mest på batteriet. Hold Macen unna sola og borte fra myke underlag når den jobber hardt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmte slijt een batterij het snelst. Houd de Mac uit de zon en weg van zachte oppervlakken als hij zwaar werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciepło najszybciej zużywa baterię. Gdy Mac mocno pracuje, trzymaj go z dala od słońca i miękkich powierzchni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O calor é o que mais desgasta a bateria. Mantenha o Mac longe do sol e de superfícies macias quando estiver a trabalhar muito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căldura uzează bateria cel mai repede. Când Mac-ul lucrează intens, țineți-l departe de soare și de suprafețe moi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teplo opotrebúva batériu najrýchlejšie. Keď Mac intenzívne pracuje, nenechávajte ho na slnku ani na mäkkom povrchu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplota najhitreje obrablja baterijo. Ko Mac močno dela, ga ne puščajte na soncu ali na mehkih površinah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värme sliter mest på batteriet. Håll Macen borta från solen och mjuka underlag när den arbetar hårt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найшвидше акумулятор зношується від тепла. Коли Mac працює з навантаженням, тримайте його подалі від сонця й м’яких поверхонь."
          }
        }
      }
    },
