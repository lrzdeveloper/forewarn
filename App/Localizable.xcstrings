        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple úgy tervezi ezt az akkumulátort, hogy %@ ciklusnál is megőrizze eredeti kapacitásának 80%%-át."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
