    "Before the battery reaches 10%, if that comes before you usually plug in." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преди батерията да стигне 10%, ако това стане преди обичайното ви включване в зарядното."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abans que la bateria arribi al 10 %, si passa abans de l’hora en què normalment el connectes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než baterie klesne na 10%, pokud k tomu dojde dřív, než obvykle připojujete nabíječku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før batteriet når 10 %, hvis det sker, før du plejer at oplade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor die Batterie 10 % erreicht, falls das vor deinem üblichen Laden passiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν η μπαταρία φτάσει στο 10%, αν αυτό συμβεί πριν συνήθως συνδέσετε τον φορτιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que la batería llegue al 10 %, si ocurre antes de cuando sueles conectarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enne kui aku jõuab 10%-ni, kui see juhtub enne su tavapärast laadimisaega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen kuin akun varaus laskee 10 prosenttiin, jos se tapahtuu ennen tavallista latausaikaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant que la batterie n’atteigne 10 %, si c’est avant l’heure où vous branchez d’habitude."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sula sroicheann an ceallra 10%, má tharlaíonn sé sin roimh an am a bplugálann tú isteach de ghnáth."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije nego što baterija padne na 10%, ako se to dogodi prije nego što obično priključite punjač."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mielőtt az akkumulátor 10%-ra merül, ha ez a szokásos töltés előtt történik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che la batteria arrivi al 10%, se succede prima di quando di solito ti colleghi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš akumuliatoriui pasiekiant 10%, jei tai įvyks anksčiau, nei paprastai prijungiate maitinimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirms akumulators sasniedz 10%, ja tas notiek agrāk, nekā parasti pievienojat lādētāju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qabel ma l-batterija tasal għal 10%, jekk dan jiġri qabel ma normalment tqabbad."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før batteriet når 10 %, hvis det skjer før du pleier å lade."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat de batterij 10% bereikt, als dat eerder is dan wanneer je meestal laadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim bateria spadnie do 10%, jeśli nastąpi to przed porą, gdy zwykle podłączasz zasilanie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de a bateria chegar aos 10%, se isso acontecer antes de costumar ligar à corrente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte ca bateria să ajungă la 10%, dacă asta se întâmplă înainte să o conectați de obicei la priză."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skôr ako batéria klesne na 10%, ak sa to stane skôr, než zvyčajne pripájate nabíjačku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preden baterija pade na 10%, če se to zgodi pred časom, ko običajno priključite polnilnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan batteriet når 10 %, om det sker innan du brukar ladda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж акумулятор розрядиться до 10%, якщо це станеться раніше, ніж ви зазвичай підключаєте живлення."
          }
        }
      }
    },
