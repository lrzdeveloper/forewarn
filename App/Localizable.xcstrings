    "Not filling up at the pace of the last 30 days." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не се запълва при темпото от последните 30 дни."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’omple al ritme dels últims 30 dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempem posledních 30 dnů se nezaplňuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyldes ikke op i tempoet fra de sidste 30 dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Tempo der letzten 30 Tage nicht voll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν γεμίζει με τον ρυθμό των τελευταίων 30 ημερών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se llena al ritmo de los últimos 30 días."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimase 30 päeva tempos see ei täitu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei täyty viimeisten 30 päivän tahdilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne se remplit pas au rythme des 30 derniers jours."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl sé ag líonadh ag ráta na 30 lá seo caite."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne puni se tempom posljednjih 30 dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elmúlt 30 nap üteme alapján nem telik meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo degli ultimi 30 giorni non si sta riempiendo."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagal pastarųjų 30 dienų tempą nesipildo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pēc pēdējo 30 dienu tempa nepildās."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mhix qed timtela bir-ritmu tal-aħħar 30 jum."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylles ikke opp i takten fra de siste 30 dagene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loopt niet vol in het tempo van de afgelopen 30 dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zapełnia się w tempie z ostatnich 30 dni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não está a encher ao ritmo dos últimos 30 dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se umple în ritmul ultimelor 30 de zile."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri tempe z posledných 30 dní sa nezapĺňa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri tempu zadnjih 30 dni se ne polni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylls inte i takten från de senaste 30 dagarna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За темпом останніх 30 днів не заповнюється."
          }
        }
      }
    },
