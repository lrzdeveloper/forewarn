    "You closed three warnings in a row, so Forewarn now warns you later about: %@." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затворихте три предупреждения подред, затова Forewarn вече ви предупреждава по-късно за: %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has tancat tres avisos seguits, així que ara Forewarn t’avisa més tard sobre: %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřeli jste tři varování po sobě, takže vás teď Forewarn bude varovat později. Týká se: %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lukkede tre advarsler i træk, så Forewarn advarer dig nu senere om: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast drei Warnungen in Folge geschlossen, daher warnt Forewarn dich jetzt später bei: %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείσατε τρεις προειδοποιήσεις στη σειρά, οπότε το Forewarn θα σας προειδοποιεί πλέον αργότερα για: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has cerrado tres avisos seguidos, así que ahora Forewarn te avisa más tarde sobre: %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulgesid kolm hoiatust järjest, seega hoiatab Forewarn nüüd hiljem teemal: %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suljit kolme varoitusta peräkkäin, joten Forewarn varoittaa nyt myöhemmin aiheesta: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez fermé trois alertes d’affilée, Forewarn vous prévient donc plus tard pour : %@."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhún tú trí rabhadh as a chéile, mar sin tugann Forewarn rabhadh níos déanaí duit anois faoi: %@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorili ste tri upozorenja zaredom pa vas Forewarn sada upozorava kasnije. Odnosi se na: %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három figyelmeztetést zárt be egymás után, ezért a Forewarn mostantól később figyelmeztet erről: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai chiuso tre avvisi di fila, quindi ora Forewarn ti avvisa più tardi per: %@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uždarėte tris įspėjimus iš eilės, todėl dabar Forewarn įspės vėliau apie: %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs aizvērāt trīs brīdinājumus pēc kārtas, tāpēc Forewarn tagad brīdinās vēlāk par: %@."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għalaqt tliet twissijiet wara xulxin, allura issa Forewarn iwissik aktar tard dwar: %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lukket tre varsler på rad, så Forewarn varsler deg nå senere om: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt drie waarschuwingen achter elkaar gesloten, dus Forewarn waarschuwt je nu later voor: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy kolejne ostrzeżenia zostały zamknięte, więc Forewarn ostrzega teraz później. Dotyczy: %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechou três avisos seguidos, por isso o Forewarn passa a avisá-lo mais tarde sobre: %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ați închis trei avertizări la rând, așa că acum Forewarn vă avertizează mai târziu pentru: %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorili ste tri upozornenia za sebou, preto vás Forewarn teraz upozorní neskôr. Týka sa: %@."
          }
