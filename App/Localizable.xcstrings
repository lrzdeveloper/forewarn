        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se trouve dans la barre des menus. Cliquez dessus à tout moment pour voir la prévision."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá Forewarn sa bharra roghchláir. Cliceáil air am ar bith chun an réamhaisnéis a fheiceáil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se nalazi u traci izbornika. Kliknite ga bilo kada da biste vidjeli prognozu."
