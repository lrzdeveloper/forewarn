    "Forewarn lives in the menu bar. Click it any time to see the forecast." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn е в лентата с менюта. Щракнете по всяко време, за да видите прогнозата."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn viu a la barra de menús. Fes-hi clic quan vulguis per veure la previsió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn najdete v řádku nabídek. Kdykoli na něj klikněte a uvidíte předpověď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn bor i menulinjen. Klik på den når som helst for at se prognosen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lebt in der Menüleiste. Klicke jederzeit darauf, um die Prognose zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Forewarn βρίσκεται στη γραμμή μενού. Κάντε κλικ οποιαδήποτε στιγμή για να δείτε την πρόβλεψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn vive en la barra de menús. Haz clic cuando quieras para ver la previsión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn asub menüüribal. Klõpsa seda millal tahes, et prognoosi näha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn asuu valikkorivillä. Näet ennusteen osoittamalla sitä milloin tahansa."
