          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn cuenta cuántos datos pasan por una red, no qué contienen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
