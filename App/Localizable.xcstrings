    "Learning how fast it fills." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Научава колко бързо се запълва."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprenent com de ràpid s’omple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učím se, jak rychle se plní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lærer, hvor hurtigt den fyldes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt noch, wie schnell sie voll wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνει πόσο γρήγορα γεμίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendiendo lo rápido que se llena."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Õpib, kui kiiresti see täitub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opettelee, miten nopeasti se täyttyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprentissage de la vitesse de remplissage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ag foghlaim cé chomh tapa is a líontar é."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učim koliko se brzo puni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még tanulja, milyen gyorsan telik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto imparando quanto in fretta si riempie."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokausi, kaip greitai pildosi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mācos, cik ātri tas pildās."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qed jitgħallem kemm timtela malajr."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lærer hvor raskt den fylles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert nog hoe snel hij volloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczę się, jak szybko się zapełnia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aprender a rapidez com que enche."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învață cât de repede se umple."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učím sa, ako rýchlo sa zapĺňa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učim se, kako hitro se polni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lär sig hur snabbt den fylls."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивчаю, як швидко він заповнюється."
          }
        }
      }
    },
    "Learns when you usually plug in, and warns you if the battery would run low before then." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Научава кога обикновено включвате зарядното и ви предупреждава, ако батерията би се изтощила преди това."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprèn quan sols connectar-lo i t’avisa si la bateria s’esgotaria abans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučí se, kdy obvykle připojujete nabíječku, a varuje vás, pokud by baterie došla dřív."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lærer, hvornår du plejer at oplade, og advarer dig, hvis batteriet løber tør inden da."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt, wann du meist lädst, und warnt dich, falls die Batterie vorher knapp würde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνει πότε συνήθως συνδέετε τον φορτιστή και σας προειδοποιεί αν η μπαταρία θα αδειάσει πριν από τότε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende cuándo sueles conectarlo y te avisa si la batería se agotaría antes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Õpib, millal sa tavaliselt laed, ja hoiatab, kui aku saaks enne seda tühjaks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppii, milloin yleensä lataat, ja varoittaa, jos akku loppuisi sitä ennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprend quand vous branchez d’habitude et vous prévient si la batterie risque de s’épuiser avant."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foghlaimíonn sé cathain a phlugálann tú isteach de ghnáth, agus tugann sé rabhadh duit dá n-ídeofaí an ceallra roimhe sin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uči kada obično priključujete punjač i upozorava vas ako bi se baterija prije toga ispraznila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megtanulja, mikor szokta töltőre tenni a Macet, és figyelmeztet, ha az akkumulátor addig lemerülne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impara quando di solito ti colleghi e ti avvisa se la batteria finirebbe prima."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išmoksta, kada paprastai prijungiate maitinimą, ir įspėja, jei akumuliatorius iki tol išsikrautų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemācās, kad parasti pievienojat lādētāju, un brīdina, ja akumulators līdz tam izlādētos."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jitgħallem meta normalment tqabbad, u jwissik jekk il-batterija tkun se tispiċċa qabel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lærer når du pleier å lade, og varsler deg hvis batteriet blir lavt før det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert wanneer je meestal laadt en waarschuwt je als de batterij daarvoor leeg dreigt te raken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczy się, kiedy zwykle podłączasz zasilanie, i ostrzega, jeśli bateria wyczerpie się wcześniej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende quando costuma ligar à corrente e avisa-o se a bateria se esgotar antes disso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învață când conectați de obicei la priză și vă avertizează dacă bateria s-ar descărca înainte."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučí sa, kedy zvyčajne pripájate nabíjačku, a upozorní vás, ak by sa batéria vybila skôr."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauči se, kdaj običajno priključite polnilnik, in vas opozori, če bi se baterija prej izpraznila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lär sig när du brukar ladda och varnar om batteriet skulle ta slut innan dess."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивчає, коли ви зазвичай підключаєте живлення, і попереджає, якщо акумулятор розрядиться раніше."
          }
        }
      }
    },
