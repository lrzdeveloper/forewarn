    "Forewarn asks for permission the first time a warning would help." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn иска разрешение първия път, когато предупреждение би помогнало."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn demana permís la primera vegada que un avís pot ser útil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn si vyžádá povolení, až bude varování poprvé užitečné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn beder om tilladelse, første gang en advarsel kan hjælpe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn fragt um Erlaubnis, sobald eine Warnung zum ersten Mal hilft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Forewarn ζητά άδεια την πρώτη φορά που μια προειδοποίηση θα βοηθούσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn pide permiso la primera vez que un aviso sea útil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn küsib luba esimesel korral, kui hoiatusest oleks abi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn pyytää lupaa, kun varoituksesta on ensimmäisen kerran hyötyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn demande l’autorisation la première fois qu’une alerte serait utile."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iarrann Forewarn cead an chéad uair a chabhródh rabhadh."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn će zatražiti dopuštenje kad upozorenje prvi put bude korisno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forewarn akkor kér engedélyt, amikor egy figyelmeztetés először hasznos lenne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn chiede il permesso la prima volta che un avviso serve davvero."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn paprašys leidimo, kai įspėjimas pirmą kartą bus naudingas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lūgs atļauju, kad brīdinājums pirmo reizi noderēs."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn jitlob il-permess l-ewwel darba li twissija tkun utli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn ber om tillatelse første gang et varsel kan hjelpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn vraagt om toestemming zodra een waarschuwing voor het eerst helpt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn poprosi o zgodę, gdy ostrzeżenie po raz pierwszy się przyda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
