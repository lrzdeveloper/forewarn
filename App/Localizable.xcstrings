    "Battery level, free disk space, network totals and sleep events, kept in your Library folder." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниво на батерията, свободно място на диска, общ мрежов трафик и събития на сън, съхранявани в папката ви Библиотека."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivell de bateria, espai lliure al disc, totals de xarxa i esdeveniments de repòs, desats a la teva carpeta Biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úroveň baterie, volné místo na disku, souhrny síťového provozu a události spánku, uložené ve složce Knihovna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriniveau, ledig diskplads, netværkstotaler og vågeblushændelser, gemt i mappen Bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterieladung, freier Speicherplatz, Netzwerksummen und Ruhezustände, gespeichert in deinem Library-Ordner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στάθμη μπαταρίας, ελεύθερος χώρος δίσκου, σύνολα δικτύου και συμβάντα ύπνου, αποθηκευμένα στον φάκελο Βιβλιοθήκη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivel de batería, espacio libre en disco, totales de red y eventos de reposo, guardados en tu carpeta Librería."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akutase, vaba kettaruum, võrgu kogumahud ja unerežiimi sündmused, mida hoitakse kaustas Library."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun varaus, vapaa levytila, verkkoliikenteen summat ja lepotilatapahtumat, tallennettuina Kirjasto-kansioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau de batterie, espace disque libre, totaux réseau et mises en veille, conservés dans votre dossier Bibliothèque."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leibhéal ceallra, spás saor ar an diosca, iomláin líonra agus imeachtaí codlata, coinnithe i d’fhillteán Library."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razina baterije, slobodan prostor na disku, ukupni mrežni promet i događaji mirovanja, spremljeni u mapi Knjižnica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltöttségi szint, szabad lemezterület, hálózati összesítők és alvási események, a Könyvtár mappában tárolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livello della batteria, spazio libero, totali di rete ed eventi di stop, conservati nella tua cartella Libreria."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akumuliatoriaus lygis, laisva vieta diske, tinklo sumos ir miego įvykiai, saugomi jūsų aplanke Biblioteka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akumulatora līmenis, brīvā vieta diskā, tīkla kopsummas un miega notikumi, kas glabājas jūsu mapē Bibliotēka."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livell tal-batterija, spazju disponibbli fuq id-diska, totali tan-netwerk u avvenimenti tal-irqad, maħżuna fil-folder Library tiegħek."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterinivå, ledig diskplass, nettverkstotaler og dvalehendelser, lagret i Bibliotek-mappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterijniveau, vrije schijfruimte, netwerktotalen en sluimergebeurtenissen, bewaard in je map Bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom baterii, wolne miejsce na dysku, sumy ruchu sieciowego i zdarzenia uśpienia, zapisane w folderze Biblioteki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nível da bateria, espaço livre, totais de rede e eventos de pausa, guardados na sua pasta Biblioteca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivelul bateriei, spațiul liber pe disc, totalurile de rețea și evenimentele de repaus, păstrate în dosarul Bibliotecă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úroveň batérie, voľné miesto na disku, súhrny sieťovej prevádzky a udalosti spánku, uložené v priečinku Knižnica."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raven baterije, prosti prostor na disku, skupni omrežni promet in dogodki mirovanja, shranjeni v mapi Knjižnica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterinivå, ledigt diskutrymme, nätverkssummor och vilohändelser, sparade i mappen Bibliotek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
