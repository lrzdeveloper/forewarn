        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn sa nepodarilo reštartovať. Skúste to znova alebo Forewarn ukončite a znova otvorte."
          }
        },
        "sl" : {
          "stringUnit" : {
