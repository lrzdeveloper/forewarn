        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn не потребує облікового запису і не просить особливих дозволів."
          }
        }
      }
    },
    "Forewarn reads battery, disk, network counters and sleep events. Nothing leaves this Mac." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn чете батерията, диска, мрежовите броячи и събитията на сън. Нищо не напуска този Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn llegeix la bateria, el disc, els comptadors de xarxa i els esdeveniments de repòs. Res no surt d’aquest Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn čte baterii, disk, síťové čítače a události spánku. Nic neopustí tento Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn læser batteri, disk, netværkstællere og vågeblushændelser. Intet forlader denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn liest Batterie, Festplatte, Netzwerkzähler und Ruhezustände. Nichts verlässt diesen Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Forewarn διαβάζει μπαταρία, δίσκο, μετρητές δικτύου και συμβάντα ύπνου. Τίποτα δεν φεύγει από αυτό το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lee la batería, el disco, los contadores de red y los eventos de reposo. Nada sale de este Mac."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn loeb akut, ketast, võrguloendureid ja unerežiimi sündmusi. Miski ei lahku sellest Macist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lukee akkua, levyä, verkkolaskureita ja lepotilatapahtumia. Mikään ei lähde tästä Macista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lit la batterie, le disque, les compteurs réseau et les mises en veille. Rien ne quitte ce Mac."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léann Forewarn an ceallra, an diosca, áiritheoirí líonra agus imeachtaí codlata. Ní fhágann aon rud an Mac seo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
