    "macOS marks iPhone hotspots and some cellular connections as expensive. Wi-Fi and Ethernet are not counted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS отбелязва хотспотовете от iPhone и някои мобилни връзки като платени по трафик. Wi-Fi и Ethernet не се броят."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS marca com a dades limitades els punts d’accés d’iPhone i algunes connexions mòbils. No es compten la Wi-Fi ni l’Ethernet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS označuje hotspoty iPhonu a některá mobilní připojení jako měřená. Wi-Fi a Ethernet se nepočítají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS markerer internetdeling fra iPhone og visse mobilforbindelser som databegrænsede. Wi-Fi og Ethernet tælles ikke med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS markiert iPhone-Hotspots und einige Mobilfunkverbindungen als getaktet. WLAN und Ethernet zählen nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS επισημαίνει τα hotspot του iPhone και ορισμένες συνδέσεις κινητής ως συνδέσεις με ογκοχρέωση. Τα Wi-Fi και Ethernet δεν μετρώνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS marca como de uso medido los puntos de acceso de iPhone y algunas conexiones móviles. No se cuentan la Wi-Fi ni Ethernet."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS märgib iPhone'i levialad ja mõned mobiilsideühendused mahupiiranguga ühendusteks. Wi-Fi-d ja Etherneti ei arvestata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS merkitsee iPhonen yhteyspisteet ja jotkin mobiiliyhteydet datarajoitetuiksi. Wi-Fiä ja Ethernetiä ei lasketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS considère comme limités les partages de connexion d’iPhone et certaines connexions cellulaires. Le Wi-Fi et l’Ethernet ne sont pas comptés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcálann macOS hotspots iPhone agus roinnt nasc ceallach mar mhéadraithe. Ní chomhairítear Wi-Fi ná Ethernet."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS označava pristupne točke iPhonea i neke mobilne veze kao mjerene. Wi-Fi i Ethernet se ne broje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS forgalomdíjasnak jelöli az iPhone-os hotspotokat és egyes mobilkapcsolatokat. A Wi-Fi és az Ethernet nem számít bele."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS segna come a consumo gli hotspot dell'iPhone e alcune connessioni cellulari. Wi-Fi ed Ethernet non vengono contati."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS žymi iPhone prieigos taškus ir kai kuriuos mobiliojo ryšio jungimus kaip matuojamus. Wi-Fi ir Ethernet neskaičiuojami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS atzīmē iPhone tīklājus un dažus mobilos savienojumus kā ierobežotus. Wi-Fi un Ethernet netiek skaitīti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS jimmarka l-hotspots tal-iPhone u xi konnessjonijiet ċellulari b’data limitata. Il-Wi-Fi u l-Ethernet ma jingħaddux."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS merker Delt Internett fra iPhone og noen mobiltilkoblinger som databegrensede. Wi-Fi og Ethernet telles ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS merkt iPhone-hotspots en sommige mobiele verbindingen aan als verbinding met datalimiet. Wifi en ethernet tellen niet mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS oznacza hotspoty iPhone’a i niektóre połączenia komórkowe jako taryfowe. Wi-Fi i Ethernet nie są liczone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS marca como limitados os hotspots de iPhone e algumas ligações móveis. Wi-Fi e Ethernet não são contados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS marchează drept contorizate hotspoturile iPhone și unele conexiuni celulare. Wi-Fi și Ethernet nu sunt numărate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS označuje hotspoty iPhonu a niektoré mobilné pripojenia ako merané. Wi-Fi a Ethernet sa nepočítajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS dostopne točke iPhona in nekatere mobilne povezave označi kot merjene. Wi-Fi in Ethernet se ne štejeta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
