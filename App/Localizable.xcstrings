    "When a night costs far more battery than usual, and which app kept it awake." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато една нощ изразходва много повече батерия от обичайното и кое приложение не е позволило на Mac да заспи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan una nit gasta molta més bateria del normal, i quina app ha mantingut el Mac despert."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se baterie přes noc vybije mnohem víc než obvykle, a která aplikace nenechala Mac usnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en nat bruger langt mere batteri end normalt, og hvilken app der holdt Mac'en vågen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Nacht viel mehr Batterie kostet als üblich, und welche App den Mac wach gehalten hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μια νύχτα καταναλώνει πολύ περισσότερη μπαταρία από το συνηθισμένο, και ποια εφαρμογή κράτησε ξύπνιο το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una noche gasta mucha más batería de lo normal, y qué app mantuvo despierto el Mac."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui öö kulutab tavapärasest palju rohkem akut ja milline rakendus hoidis Maci ärkvel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun yö kuluttaa akkua paljon tavallista enemmän, ja mikä appi piti Macin hereillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une nuit consomme bien plus de batterie que d’habitude, et quelle app a maintenu le Mac éveillé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuair a ídíonn oíche i bhfad níos mó ceallra ná mar is gnách, agus cén aip a choinnigh an Mac ina dhúiseacht."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad se baterija preko noći isprazni znatno više nego inače i koja je aplikacija držala Mac budnim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egy éjszaka a szokásosnál sokkal több akkumulátort fogyaszt, és melyik app tartotta ébren a Macet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una notte consuma molta più batteria del solito, e quale app ha tenuto sveglio il Mac."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai per naktį akumuliatorius išsikrauna daug labiau nei įprastai, ir kokia programa neleido Mac užmigti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad nakts izlādē akumulatoru daudz vairāk nekā parasti un kura lietotne neļāva Mac aizmigt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta lejl jieħu ħafna aktar batterija mis-soltu, u liema app żammet il-Mac imqajjem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en natt bruker mye mer batteri enn vanlig, og hvilken app som holdt Macen våken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
