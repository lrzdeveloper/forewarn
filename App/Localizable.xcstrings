    "Apple designs this battery to keep 80%% of its original capacity at %@ cycles." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple проектира тази батерия да запазва 80%% от първоначалния си капацитет при %@ цикъла."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dissenya aquesta bateria perquè conservi el 80 %% de la seva capacitat original als %@ cicles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple navrhuje tuto baterii tak, aby si při %@ cyklech udržela 80%% původní kapacity."
          }
        },
        "da" : {
          "stringUnit" : {
