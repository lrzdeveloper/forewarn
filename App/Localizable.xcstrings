    "Time left follows how you use the Mac right now. While charging it shows the time to full." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставащото време следва как използвате Mac в момента. При зареждане показва времето до пълно зареждане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El temps restant segueix com fas servir el Mac ara mateix. Mentre carrega, mostra el temps fins a la càrrega completa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývající čas odpovídá tomu, jak Mac právě používáte. Při nabíjení ukazuje čas do plného nabití."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende tid følger, hvordan du bruger Mac'en lige nu. Under opladning vises tiden, til den er fuld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Restzeit richtet sich danach, wie du den Mac gerade nutzt. Beim Laden zeigt sie die Zeit bis voll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολειπόμενος χρόνος ακολουθεί το πώς χρησιμοποιείτε το Mac τώρα. Κατά τη φόρτιση δείχνει τον χρόνο έως την πλήρη φόρτιση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo restante sigue cómo usas el Mac ahora. Al cargar, muestra el tiempo hasta la carga completa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järelejäänud aeg sõltub sellest, kuidas sa Maci praegu kasutad. Laadimise ajal näidatakse aega täislaadimiseni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäljellä oleva aika perustuu siihen, miten käytät Macia juuri nyt. Latauksen aikana näkyy aika täyteen lataukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps restant suit votre usage actuel du Mac. En charge, il indique le temps avant la charge complète."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braitheann an t-am fágtha ar conas atá tú ag úsáid an Mac faoi láthair. Le linn luchtaithe, taispeántar an t-am go dtí go mbeidh sé lán."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preostalo vrijeme prati kako trenutačno koristite Mac. Tijekom punjenja prikazuje vrijeme do pune baterije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hátralévő idő a Mac aktuális használatát követi. Töltés közben a teljes feltöltésig hátralévő időt mutatja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo rimanente segue come usi il Mac adesso. In carica mostra il tempo alla carica completa."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likęs laikas priklauso nuo to, kaip dabar naudojate Mac. Įkraunant rodomas laikas iki pilnos įkrovos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlikušais laiks atkarīgs no tā, kā jūs pašlaik lietojat Mac. Uzlādes laikā tas rāda laiku līdz pilnai uzlādei."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ħin li fadal isegwi kif qed tuża l-Mac bħalissa. Waqt li tiċċarġja juri l-ħin sakemm timtela."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenværende tid følger hvordan du bruker Macen akkurat nå. Under lading vises tiden til den er full."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De resterende tijd volgt hoe je de Mac nu gebruikt. Tijdens het opladen toont hij de tijd tot vol."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostały czas zależy od tego, jak teraz używasz Maca. Podczas ładowania pokazuje czas do pełnego naładowania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo restante segue a forma como usa o Mac agora. Ao carregar, mostra o tempo até à carga completa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpul rămas urmează felul în care folosiți Mac-ul acum. În timpul încărcării arată timpul până la încărcarea completă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostávajúci čas zodpovedá tomu, ako Mac práve používate. Pri nabíjaní ukazuje čas do úplného nabitia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preostali čas sledi temu, kako trenutno uporabljate Mac. Med polnjenjem prikazuje čas do polne baterije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återstående tid följer hur du använder Macen just nu. Vid laddning visas tiden tills den är full."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час, що залишився, залежить від того, як ви користуєтеся Mac зараз. Під час заряджання показує час до повного заряду."
          }
        }
      }
    },
