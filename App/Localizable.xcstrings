    "Warns before you run out" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждава, преди да свършат"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa abans que s’esgotin"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varuje, než dojdou"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarer, før data slipper op"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnt, bevor das Volumen ausgeht"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προειδοποιεί πριν τελειώσουν"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa antes de que se agoten"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoiatab enne, kui andmemaht otsa saab"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoittaa ennen kuin data loppuu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévient avant l’épuisement"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugann sé rabhadh sula rithfidh tú amach"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorava prije nego što ponestanu"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyelmeztet, mielőtt elfogy"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa prima di finirli"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įspėja prieš pasibaigiant"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brīdina, pirms tie beidzas"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwissik qabel ma tispiċċa"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler før dataen går tom"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwt voordat je data op is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzega, zanim się skończą"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa antes de se esgotarem"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertizează înainte să se termine"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní, skôr než sa minú"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozori, preden jih zmanjka"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varnar innan datan tar slut"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереджає, перш ніж вони закінчаться"
          }
        }
      }
    },
    "Warns weeks before the disk fills up." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
