    "At most once a month, only when something changed." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-много веднъж месечно, само при промяна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a màxim un cop al mes, només si alguna cosa ha canviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejvýše jednou měsíčně, jen když se něco změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højst én gang om måneden og kun, når noget har ændret sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens einmal im Monat und nur, wenn sich etwas geändert hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πολύ μία φορά τον μήνα, μόνο όταν κάτι αλλάξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como mucho una vez al mes, solo si algo ha cambiado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõige rohkem kord kuus ja ainult siis, kui midagi muutus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enintään kerran kuukaudessa ja vain, jos jokin on muuttunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au plus une fois par mois, seulement si quelque chose a changé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uair sa mhí ar a mhéad, agus sin amháin nuair a athraíonn rud éigin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najviše jednom mjesečno, samo kad se nešto promijeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb havonta egyszer, csak ha valami változott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al massimo una volta al mese, solo quando qualcosa è cambiato."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne dažniau kaip kartą per mėnesį, tik kai kas nors pasikeičia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne biežāk kā reizi mēnesī, tikai tad, ja kas mainījies."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-aktar darba fix-xahar, u biss meta tinbidel xi ħaġa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyst én gang i måneden, bare når noe har endret seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooguit één keer per maand, alleen als er iets is veranderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyżej raz w miesiącu, tylko gdy coś się zmieni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No máximo uma vez por mês, só quando algo mudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel mult o dată pe lună, doar când s-a schimbat ceva."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najviac raz mesačne, len keď sa niečo zmení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največ enkrat na mesec, le ko se kaj spremeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högst en gång i månaden, bara när något har ändrats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не частіше ніж раз на місяць, лише коли щось змінилося."
          }
        }
      }
    },
    "At this pace it reaches 80% within six months." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При това темпо ще стигне 80% до шест месеца."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aquest ritme arribarà al 80 % en sis mesos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto tempem klesne na 80% do šesti měsíců."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dette tempo når det 80 % inden for seks måneder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem Tempo sind es innerhalb von sechs Monaten 80 %."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με αυτόν τον ρυθμό φτάνει στο 80% μέσα σε έξι μήνες."
