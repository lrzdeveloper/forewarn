        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle tempoga jõuab see kuue kuuga 80%-ni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä tahdilla se laskee 80 prosenttiin kuudessa kuukaudessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ce rythme, elle atteindra 80 % d’ici six mois."
