          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä tahdilla akun varaus laskee siihen aikaan 10 prosenttiin, jolloin Forewarn varoittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ce rythme, la batterie atteint 10 %, le niveau où Forewarn vous avertit, à cette heure-là."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ag an ráta seo, beidh an ceallra ag 10%, an leibhéal a dtugann Forewarn rabhadh duit, ag an am sin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovim tempom baterija će u to vrijeme pasti na 10%, razinu na kojoj vas Forewarn upozorava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilyen ütemben az akkumulátor ekkor ér 10%-ra, ahol a Forewarn figyelmeztet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A questo ritmo la batteria arriva al 10%, il livello a cui Forewarn ti avvisa, a quell'ora."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokiu tempu akumuliatorius tuo metu nusikraus iki 10% – lygio, kai Forewarn jus įspėja."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šādā tempā akumulators tajā laikā sasniegs 10% — līmeni, kurā Forewarn jūs brīdina."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B’dan ir-ritmu, il-batterija tasal għal 10%, il-livell fejn Forewarn iwissik, f’dak il-ħin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dette tempoet når batteriet 10 %, nivået der Forewarn varsler deg, på det tidspunktet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dit tempo bereikt de batterij op dat moment 10%, het niveau waarop Forewarn je waarschuwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym tempie bateria spadnie o tej godzinie do 10%, czyli poziomu, przy którym Forewarn cię ostrzega."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A este ritmo, a bateria chega aos 10%, o nível em que o Forewarn o avisa, a essa hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În acest ritm, bateria ajunge atunci la 10%, nivelul la care vă avertizează Forewarn."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto tempom batéria v tom čase klesne na 10%, úroveň, pri ktorej vás Forewarn upozorní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem tempom bo baterija ob tem času padla na 10%, raven, pri kateri vas Forewarn opozori."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I den här takten når batteriet 10 %, nivån där Forewarn varnar dig, vid den tiden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За такого темпу акумулятор саме в цей час розрядиться до 10% — рівня, на якому Forewarn вас попереджає."
          }
        }
      }
    },
