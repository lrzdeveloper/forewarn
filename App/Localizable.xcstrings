    "At this pace the battery is down to 10%% at %@. You usually plug in at %@, %@ too late." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При това темпо батерията ще падне до 10%% в %1$@. Обикновено включвате зарядното в %2$@, с %3$@ закъснение."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aquest ritme, la bateria baixarà al 10 %% a les %1$@. Normalment el connectes a les %2$@, %3$@ massa tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto tempem klesne baterie na 10%% v %1$@. Nabíječku obvykle připojujete v %2$@, to je o %3$@ pozdě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dette tempo er batteriet nede på 10 %% kl. %1$@. Du plejer at oplade kl. %2$@, %3$@ for sent."
          }
