          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente unos %1$@ por noche. %2$@ ha mantenido despierto el Mac."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavaliselt umbes %1$@ öö kohta. %2$@ hoidis Maci ärkvel."
