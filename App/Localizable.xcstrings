    },
    "If this month's pace would reach your limit before the reset day, Forewarn tells you when." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако при темпото този месец лимитът бъде достигнат преди деня на подновяване, Forewarn ви казва кога."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si al ritme d’aquest mes arribaries al límit abans del dia de renovació, Forewarn et diu quan."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud byste tempem tohoto měsíce dosáhli limitu před dnem obnovení, Forewarn vám řekne, kdy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis månedens tempo vil nå din grænse før nulstillingsdagen, fortæller Forewarn dig hvornår."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Tempo dieses Monats dein Limit vor dem Rücksetztag erreicht, sagt dir Forewarn, wann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν με τον ρυθμό αυτού του μήνα φτάσετε το όριο πριν από την ημέρα ανανέωσης, το Forewarn σας λέει πότε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si al ritmo de este mes llegarías al límite antes del día de reinicio, Forewarn te dice cuándo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui selle kuu tempoga jõuad limiidini enne lähtestamise päeva, ütleb Forewarn, millal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämän kuun tahdilla raja täyttyy ennen nollautumispäivää, Forewarn kertoo milloin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le rythme de ce mois atteint votre limite avant le jour de réinitialisation, Forewarn vous dit quand."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má shroicheann ráta na míosa seo do theorainn roimh an lá athshocraithe, inseoidh Forewarn duit cathain."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako biste tempom ovog mjeseca dosegli ograničenje prije dana obnove, Forewarn će vam reći kada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a havi ütem a megújulás napja előtt elérné a keretet, a Forewarn jelzi, mikor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il ritmo di questo mese raggiungerebbe il limite prima del giorno di rinnovo, Forewarn ti dice quando."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei šio mėnesio tempu pasiektumėte limitą iki atsinaujinimo dienos, Forewarn praneš, kada."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja šī mēneša tempā sasniegtu limitu pirms atjaunošanas dienas, Forewarn pateiks, kad."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jekk bir-ritmu ta’ dan ix-xahar tilħaq il-limitu qabel il-jum tat-tiġdid, Forewarn jgħidlek meta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis månedens tempo vil nå grensen før nullstillingsdagen, forteller Forewarn deg når."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je in het tempo van deze maand je limiet vóór de resetdag bereikt, laat Forewarn je weten wanneer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli w tym tempie dojdziesz do limitu przed dniem odnowienia, Forewarn powie ci, kiedy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o ritmo deste mês atingir o limite antes do dia de renovação, o Forewarn diz-lhe quando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ritmul din luna aceasta ar atinge limita înainte de ziua resetării, Forewarn vă spune când."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak by ste tempom tohto mesiaca dosiahli limit pred dňom obnovenia, Forewarn vám povie, kedy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če bi s tempom tega meseca dosegli omejitev pred dnevom ponastavitve, vam Forewarn pove, kdaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om månadens takt skulle nå gränsen före nollställningsdagen säger Forewarn till när."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо за темпу цього місяця ви досягнете ліміту до дня оновлення, Forewarn скаже, коли саме."
          }
        }
      }
    },
