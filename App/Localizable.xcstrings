            "value" : "Forewarn ikejjel l-enerġija li juża hu stess u juriha fil-menu. L-għan: inqas minn 0.05% tal-batterija kuljum."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn måler sitt eget energiforbruk og viser det i menyen. Målet: under 0,05 % av batteriet per dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn meet zijn eigen energieverbruik en toont dat in het menu. Het doel: minder dan 0,05% van de batterij per dag."
