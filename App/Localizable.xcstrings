    },
    "Forewarn counts how much data goes through a network, not what is in it." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn брои колко данни минават през мрежата, а не какво съдържат."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn compta quantes dades passen per una xarxa, no què contenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn počítá, kolik dat projde sítí, ne co obsahují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn tæller, hvor meget data der går gennem et netværk, ikke hvad de indeholder."
