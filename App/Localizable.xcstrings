    "Charging now. Forecasts resume when you unplug." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарежда се. Прогнозите продължават, когато изключите зарядното."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregant. Les previsions es reprenen en desconnectar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabíjí se. Předpovědi budou pokračovat po odpojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplader. Prognoserne fortsætter, når du tager stikket ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt gerade. Prognosen laufen weiter, sobald du das Netzteil trennst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φορτίζει. Οι προβλέψεις συνεχίζονται όταν αποσυνδέσετε τον φορτιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargando. Las previsiones se reanudan al desconectar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laeb. Prognoosid jätkuvad, kui laadija lahti ühendad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latautuu. Ennusteet jatkuvat, kun irrotat laturin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En charge. Les prévisions reprennent quand vous débranchez."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Á luchtú. Atosóidh na réamhaisnéisí nuair a dhíphlugálann tú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punjenje. Prognoze se nastavljaju kad isključite punjač."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltés folyamatban. Az előrejelzés a töltő leválasztása után folytatódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In carica. Le previsioni riprendono quando scolleghi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įkraunama. Prognozės atsinaujins, kai atjungsite maitinimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzlādējas. Prognozes atsāksies, kad atvienosiet lādētāju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qed tiċċarġja. It-tbassir jerġa’ jibda meta tiddiskonnettja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader. Prognosene fortsetter når du kobler fra laderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt opgeladen. Voorspellingen gaan verder als je loskoppelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ładowanie. Prognozy wrócą po odłączeniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carregar. As previsões retomam quando desligar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se încarcă. Previziunile se reiau când deconectați."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabíja sa. Predpovede budú pokračovať po odpojení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
