    "Forewarn learns how you use this Mac and warns you before something runs out, with the time it will happen." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn научава как използвате този Mac и ви предупреждава, преди нещо да свърши, с точния час."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn aprèn com fas servir aquest Mac i t’avisa abans que s’esgoti alguna cosa, amb l’hora en què passarà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se učí, jak používáte tento Mac, a varuje vás, než něco dojde, i s časem, kdy se to stane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lærer, hvordan du bruger denne Mac, og advarer dig, før noget løber tør, med tidspunktet for hvornår."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lernt, wie du diesen Mac nutzt, und warnt dich, bevor etwas ausgeht – mit dem Zeitpunkt, wann es so weit ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Forewarn μαθαίνει πώς χρησιμοποιείτε αυτό το Mac και σας προειδοποιεί πριν κάτι τελειώσει, με την ώρα που θα συμβεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn aprende cómo usas este Mac y te avisa antes de que algo se agote, con la hora en que ocurrirá."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn õpib, kuidas sa seda Maci kasutad, ja hoiatab enne, kui midagi otsa saab, koos kellaajaga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn oppii, miten käytät tätä Macia, ja varoittaa ennen kuin jokin loppuu – ja kertoo milloin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn apprend comment vous utilisez ce Mac et vous prévient avant que quelque chose s’épuise, avec l’heure à laquelle cela arrivera."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foghlaimíonn Forewarn conas a úsáideann tú an Mac seo agus tugann sé rabhadh duit sula rithfidh rud éigin amach, mar aon leis an am a tharlóidh sé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn uči kako koristite ovaj Mac i upozorava vas prije nego što nečega ponestane, uz vrijeme kada će se to dogoditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forewarn megtanulja, hogyan használja ezt a Macet, és még azelőtt figyelmeztet, hogy valami elfogyna, megadva az időpontot is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn impara come usi questo Mac e ti avvisa prima che qualcosa finisca, con l'ora in cui succederà."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn išmoksta, kaip naudojate šį Mac, ir įspėja prieš kam nors pasibaigiant. Nurodo ir laiką, kada tai įvyks."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn iemācās, kā lietojat šo Mac, un brīdina, pirms kaut kas beidzas, norādot laiku, kad tas notiks."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn jitgħallem kif tuża dan il-Mac u jwissik qabel ma tispiċċa xi ħaġa, bil-ħin meta se jiġri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lærer hvordan du bruker denne Macen, og varsler deg før noe går tomt, med tidspunktet det skjer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn leert hoe je deze Mac gebruikt en waarschuwt je voordat iets opraakt, met het tijdstip waarop dat gebeurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn uczy się, jak używasz tego Maca, i ostrzega, zanim coś się skończy, podając godzinę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Forewarn aprende como usa este Mac e avisa-o antes de algo se esgotar, com a hora a que vai acontecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn învață cum folosiți acest Mac și vă avertizează înainte să se termine ceva, cu ora la care se va întâmpla."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn sa učí, ako používate tento Mac, a upozorní vás, skôr než niečo dôjde, aj s časom, kedy sa to stane."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn se uči, kako uporabljate ta Mac, in vas opozori, preden česa zmanjka, skupaj s časom, ko se bo to zgodilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn lär sig hur du använder den här Macen och varnar dig innan något tar slut, med tiden då det händer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn вивчає, як ви користуєтеся цим Mac, і попереджає, перш ніж щось закінчиться, із часом, коли це станеться."
          }
        }
      }
    },
