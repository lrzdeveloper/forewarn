    "Spots nights that cost far more battery than usual, and names the app that kept the Mac awake." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открива нощите, в които батерията се изразходва много повече от обичайното, и посочва приложението, което не е позволило на Mac да заспи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta les nits que gasten molta més bateria del normal i indica quina app ha mantingut el Mac despert."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpozná noci, kdy se baterie vybila mnohem víc než obvykle, a uvede aplikaci, která nenechala Mac usnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nætter, der bruger langt mere batteri end normalt, og nævner den app, der holdt Mac'en vågen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt Nächte, die viel mehr Batterie kosten als üblich, und nennt die App, die den Mac wach gehalten hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντοπίζει νύχτες που καταναλώνουν πολύ περισσότερη μπαταρία από το συνηθισμένο και κατονομάζει την εφαρμογή που κράτησε ξύπνιο το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta las noches que gastan mucha más batería de lo normal e indica qué app mantuvo despierto el Mac."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkab öid, mis kulutavad tavapärasest palju rohkem akut, ja nimetab rakenduse, mis hoidis Maci ärkvel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa yöt, jotka kuluttavat akkua paljon tavallista enemmän, ja kertoo, mikä appi piti Macin hereillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repère les nuits qui consomment bien plus de batterie que d’habitude et nomme l’app qui a maintenu le Mac éveillé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aimsíonn sé oícheanta a ídíonn i bhfad níos mó ceallra ná mar is gnách, agus ainmníonn sé an aip a choinnigh an Mac ina dhúiseacht."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznaje noći u kojima se baterija ispraznila znatno više nego inače i navodi aplikaciju koja je držala Mac budnim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felismeri a szokásosnál sokkal több akkumulátort fogyasztó éjszakákat, és megnevezi az appot, amely ébren tartotta a Macet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce le notti che consumano molta più batteria del solito e dice quale app ha tenuto sveglio il Mac."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aptinka naktis, kai akumuliatorius išsikrauna daug labiau nei įprastai, ir nurodo programą, kuri neleido Mac užmigti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamana naktis, kad akumulators izlādējas daudz vairāk nekā parasti, un nosauc lietotni, kas neļāva Mac aizmigt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jinduna bl-iljieli li jieħdu ħafna aktar batterija mis-soltu, u jgħid liema app żammet il-Mac imqajjem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdager netter som bruker mye mer batteri enn vanlig, og sier hvilken app som holdt Macen våken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkent nachten die veel meer batterij kosten dan normaal, en noemt de app die de Mac wakker hield."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywa noce, w które bateria zużywa się znacznie bardziej niż zwykle, i wskazuje aplikację, która nie pozwalała Macowi spać."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deteta noites que gastam muito mais bateria do que o habitual e indica a app que manteve o Mac ativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifică nopțile care consumă mult mai multă baterie decât de obicei și numește aplicația care a ținut Mac-ul treaz."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpozná noci, keď sa batéria vybila oveľa viac ako zvyčajne, a uvedie aplikáciu, ktorá nenechala Mac zaspať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepozna noči, ko se je baterija izpraznila precej bolj kot običajno, in navede aplikacijo, ki je Mac držala budnega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittar nätter som drar mycket mer batteri än vanligt och visar vilken app som höll Macen vaken."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помічає ночі, коли акумулятор розряджається значно більше, ніж зазвичай, і називає програму, яка не давала Mac заснути."
          }
        }
      }
    },
