          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn cere permisiunea prima dată când o avertizare ar fi utilă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn si vyžiada povolenie, keď bude upozornenie prvýkrát užitočné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
