        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaprli ste tri opozorila zapored, zato vas Forewarn zdaj opozori pozneje. Velja za: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stängde tre varningar i rad, så Forewarn varnar nu senare om: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви закрили три попередження поспіль, тож тепер Forewarn попереджатиме пізніше про: %@."
          }
        }
      }
    },
    "You usually plug in around %@. Charge when you can." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обикновено включвате зарядното около %@. Заредете, когато можете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment el connectes cap a les %@. Carrega quan puguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabíječku obvykle připojujete kolem %@. Nabijte, až to půjde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du plejer at oplade omkring kl. %@. Oplad, når du kan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lädst meist gegen %@. Lade, sobald du kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνήθως συνδέετε τον φορτιστή γύρω στις %@. Φορτίστε όταν μπορείτε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueles conectarlo hacia las %@. Carga cuando puedas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavaliselt laed umbes kell %@. Lae, kui saad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataat yleensä noin klo %@. Lataa, kun voit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous branchez d’habitude vers %@. Rechargez dès que possible."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugálann tú isteach thart ar %@ de ghnáth. Luchtaigh nuair is féidir leat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punjač obično priključujete oko %@. Napunite kad možete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Általában %@ körül teszi töltőre. Töltse fel, amint tudja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito ti colleghi verso le %@. Ricarica appena puoi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paprastai maitinimą prijungiate apie %@. Įkraukite, kai galėsite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parasti pievienojat lādētāju ap plkst. %@. Uzlādējiet, kad varat."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment tqabbad madwar %@. Iċċarġja meta tista’."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du pleier å lade rundt kl. %@. Lad når du kan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laadt meestal rond %@. Laad op zodra je kunt."
