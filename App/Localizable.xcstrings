    "Your %lld%% charge limit slows wear: the battery spends less time full." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимитът на зареждане от %lld%% забавя износването: батерията прекарва по-малко време напълно заредена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu límit de càrrega del %lld %% frena el desgast: la bateria passa menys temps plena."
