        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forewarn a menüsorban található. Kattintson rá bármikor az előrejelzésért."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn sta nella barra dei menu. Fai clic quando vuoi per vedere la previsione."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forewarn gyvena meniu juostoje. Spustelėkite bet kada, kad pamatytumėte prognozę."
