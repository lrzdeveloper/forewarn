        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Apple σχεδιάζει αυτή την μπαταρία ώστε να διατηρεί το 80%% της αρχικής της χωρητικότητας στους %@ κύκλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
