            "value" : "Ag an ráta seo, sroichfear 80% laistigh de shé mhí."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovim tempom pada na 80% unutar šest mjeseci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilyen ütemben hat hónapon belül eléri a 80%-ot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A questo ritmo arriva all'80% entro sei mesi."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokiu tempu per šešis mėnesius pasieks 80%."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šādā tempā sešu mēnešu laikā sasniegs 80%."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B’dan ir-ritmu tasal għal 80% fi żmien sitt xhur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dette tempoet når det 80 % innen seks måneder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dit tempo is dat binnen zes maanden 80%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym tempie spadnie do 80% w ciągu pół roku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A este ritmo, chega aos 80% dentro de seis meses."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În acest ritm ajunge la 80% în șase luni."
