        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με αυτόν τον ρυθμό η μπαταρία πέφτει στο 10%% στις %1$@. Συνήθως συνδέετε τον φορτιστή στις %2$@, δηλαδή %3$@ πολύ αργά."
          }
        },
        "en" : {
          "stringUnit" : {
