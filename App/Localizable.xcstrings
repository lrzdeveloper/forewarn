    "Disk warnings can name what grew there. macOS asks for permission the first time." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупрежденията за диска могат да посочат какво е нараснало. macOS ще поиска разрешение първия път."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els avisos del disc poden indicar què ha crescut. macOS demana permís la primera vegada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varování o disku mohou uvést, co na něm narostlo. macOS si napoprvé vyžádá povolení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskadvarsler kan nævne, hvad der er vokset der. macOS beder om tilladelse første gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festplattenwarnungen können nennen, was dort gewachsen ist. macOS fragt beim ersten Mal um Erlaubnis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προειδοποιήσεις για τον δίσκο μπορούν να αναφέρουν τι μεγάλωσε. Το macOS ζητά άδεια την πρώτη φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos del disco pueden indicar qué ha crecido. macOS pide permiso la primera vez."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kettahoiatused saavad nimetada, mis seal kasvas. macOS küsib esimesel korral luba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levyvaroitukset voivat kertoa, mikä siellä kasvoi. macOS pyytää lupaa ensimmäisellä kerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes disque peuvent indiquer ce qui a grossi. macOS demande l’autorisation la première fois."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le rabhaidh diosca a insint cad a d’fhás ann. Iarrann macOS cead an chéad uair."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorenja o disku mogu navesti što je naraslo. macOS će prvi put zatražiti dopuštenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemezfigyelmeztetések megnevezhetik, mi nőtt meg. A macOS első alkalommal engedélyt kér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi sul disco possono dire cosa è cresciuto lì. macOS chiede il permesso la prima volta."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disko įspėjimuose gali būti nurodyta, kas jame išaugo. Pirmą kartą macOS paprašys leidimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diska brīdinājumos var norādīt, kas tur pieaudzis. macOS pirmo reizi lūgs atļauju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It-twissijiet tad-diska jistgħu jgħidu x’kiber hemm. macOS jitlob il-permess l-ewwel darba."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskvarsler kan si hva som har vokst der. macOS ber om tillatelse første gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schijfwaarschuwingen kunnen noemen wat er gegroeid is. macOS vraagt de eerste keer om toestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenia o dysku mogą wskazać, co urosło. Za pierwszym razem macOS poprosi o zgodę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os avisos do disco podem indicar o que cresceu. O macOS pede autorização da primeira vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertizările pentru disc pot numi ce a crescut. macOS cere permisiunea prima dată."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornenia na disk môžu uviesť, čo na ňom narástlo. macOS si prvýkrát vyžiada povolenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozorila o disku lahko navedejo, kaj se je povečalo. macOS bo prvič zahteval dovoljenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskvarningar kan visa vad som har vuxit där. macOS ber om tillåtelse första gången."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередження про диск можуть вказати, що саме зросло. macOS попросить дозвіл першого разу."
          }
        }
      }
    },
